{
  "name": "amazecc",
  "version": "3.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "scripts": {
    "pretest": "node scripts/generate-build-info.js",
    "test": "vitest run",
    "predev": "node scripts/generate-build-info.js",
    "dev": "next dev --webpack --experimental-https -p 3001",
    "dev:http": "next dev --webpack -p 3001",
    "prebuild": "node scripts/generate-build-info.js",
    "build": "next build --webpack && node scripts/prune-sw-precache.js",
    "start": "pnpm dlx serve@latest out -p 3001 -s",
    "serve": "pnpm dlx serve@latest out -p 3001 -s",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "catalogue:build": "node scripts/convert-codechef-catalogue.mjs",
    "scanner:dataset": "node scripts/build-scanner-dataset.mjs",
    "scanner:train": "node scripts/train-scanner-nn.mjs",
    "prepare": "husky",
    "pretypecheck": "node scripts/generate-build-info.js",
    "typecheck": "tsc --noEmit"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,css,md,json}": "prettier --write"
  },
  "dependencies": {
    "@amazecontinuityprojects/amazeui": "^1.6.1",
    "@next/third-parties": "16.4.3",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-logs": "^3.0.0",
    "@serwist/next": "9.5.13",
    "@uiw/react-heat-map": "^2.3.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.36.0",
    "html-to-image": "^1.11.13",
    "html5-qrcode": "^2.3.8",
    "jotai": "^2.15.0",
    "jspdf": "^4.2.1",
    "katex": "^0.18.2",
    "lucide-react": "^0.544.0",
    "lz-string": "^1.5.0",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.445.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-dropzone": "^14.3.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "tesseract.js": "^7.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "fake-indexeddb": "^6.2.7",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "serwist": "9.5.13",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
