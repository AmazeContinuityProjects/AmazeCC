// Faculty Reviews Worker. Placeholders (REPLACE_WITH_*) are filled by the maintainer.
// FLAGS: ENABLE_AMAZE_REVIEWS and READ_ONLY_MODE are deliberately NOT listed in "vars".
// "keep_vars": true makes wrangler leave dashboard-set variables alone, so the flags can be
// flipped in Cloudflare (Settings -> Variables and Secrets) with no deploy and survive later
// deploys. Unset = feature OFF and not read-only (code default). See docs/RUNBOOK.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amazecc-reviews-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "SNAPSHOT_STORE": "kv",
    "MAX_KV_WRITES_PER_RUN": "200",
    "VITFAC_ENABLED": "true"
  },
  "kv_namespaces": [
    {
      "binding": "REVIEWS_SNAPSHOTS",
      "id": "amazecc-reviews-snapshots-local",
      "preview_id": "amazecc-reviews-snapshots-preview"
    }
  ],
  "r2_buckets": [
    {
      "binding": "REVIEWS_BUCKET",
      "bucket_name": "amazecc-faculty-reviews",
      "preview_bucket_name": "amazecc-faculty-reviews-preview"
    }
  ],
  "queues": {
    "producers": [
      {
        "queue": "amazecc-reviews-queue",
        "binding": "amazecc_reviews_queue"
      }
    ],
    "consumers": [
      {
        "queue": "amazecc-reviews-queue",
        "max_batch_size": 25,
        "max_batch_timeout": 10,
        "max_retries": 3,
        "dead_letter_queue": "amazecc-reviews-dlq"
      }
    ]
  },
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "env": {
    "staging": {
      "name": "amazecc-reviews-worker-staging",
      "workers_dev": false,
      "observability": {
        "enabled": true
      },
      "routes": [
        {
          "pattern": "reviews-api-staging.amazecc.com",
          "custom_domain": true
        }
      ],
      "vars": {
        "SNAPSHOT_STORE": "kv",
        "MAX_KV_WRITES_PER_RUN": "200",
        "VITFAC_ENABLED": "true"
      },
      "kv_namespaces": [
        {
          "binding": "REVIEWS_SNAPSHOTS",
          "id": "REPLACE_WITH_STAGING_KV_ID",
          "preview_id": "REPLACE_WITH_STAGING_PREVIEW_KV_ID"
        }
      ],
      "r2_buckets": [
        {
          "binding": "REVIEWS_BUCKET",
          "bucket_name": "amazecc-faculty-reviews-staging"
        }
      ],
      "queues": {
        "producers": [
          {
            "queue": "amazecc-reviews-queue-staging",
            "binding": "amazecc_reviews_queue"
          }
        ],
        "consumers": [
          {
            "queue": "amazecc-reviews-queue-staging",
            "max_batch_size": 25,
            "max_batch_timeout": 10,
            "max_retries": 3,
            "dead_letter_queue": "amazecc-reviews-dlq-staging"
          }
        ]
      },
      "triggers": {
        "crons": ["*/10 * * * *"]
      },
      "keep_vars": true
    },
    "production": {
      "name": "amazecc-reviews-worker",
      "workers_dev": false,
      "observability": {
        "enabled": true
      },
      "routes": [
        {
          "pattern": "reviews-api.amazecc.com",
          "custom_domain": true
        }
      ],
      "vars": {
        "SNAPSHOT_STORE": "kv",
        "MAX_KV_WRITES_PER_RUN": "200",
        "VITFAC_ENABLED": "true"
      },
      "kv_namespaces": [
        {
          "binding": "REVIEWS_SNAPSHOTS",
          "id": "REPLACE_WITH_PRODUCTION_KV_ID",
          "preview_id": "REPLACE_WITH_PRODUCTION_PREVIEW_KV_ID"
        }
      ],
      "r2_buckets": [
        {
          "binding": "REVIEWS_BUCKET",
          "bucket_name": "amazecc-faculty-reviews"
        }
      ],
      "queues": {
        "producers": [
          {
            "queue": "amazecc-reviews-queue",
            "binding": "amazecc_reviews_queue"
          }
        ],
        "consumers": [
          {
            "queue": "amazecc-reviews-queue",
            "max_batch_size": 25,
            "max_batch_timeout": 10,
            "max_retries": 3,
            "dead_letter_queue": "amazecc-reviews-dlq"
          }
        ]
      },
      "triggers": {
        "crons": ["*/10 * * * *"]
      },
      "keep_vars": true
    }
  },
  "keep_vars": true
}
