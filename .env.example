# ==============================================================================
# AmazeCC Frontend Client Environment Variables (.env.example)
#
# Copy this file to `.env.local` for local development.
# In CI/CD or production hosting (e.g. Vercel), configure these in project settings.
#
# Rules:
# - NEXT_PUBLIC_* variables are embedded in the browser client bundle at build time.
# - NEVER store private API keys, database credentials, or HMAC secrets in this file.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Primary Backend API Configuration
# ------------------------------------------------------------------------------
# Primary backend API URL.
# Local: http://localhost:3000
# Staging: https://api-staging.amazecc.com
# Production: https://api.amazecc.com
NEXT_PUBLIC_API_URL=http://localhost:3000

# Backup mirror API URL used globally upon primary failure (Riven/fallback)
NEXT_PUBLIC_BACKUP_API_URL=https://amazecc-api-d402b5.rivendeploy.com

# Per-request third-party fallback endpoint for legacy UniCC routes
NEXT_PUBLIC_UNICC_API_URL=https://api-unicc.arya22.dev

# Feature toggle for third-party UniCC fallback ('on' or 'off')
NEXT_PUBLIC_UNICC_FALLBACK=on

# Base path for deployment on subpaths (e.g. /AmazeCC; leave empty for root domain)
NEXT_PUBLIC_BASE_PATH=

# ------------------------------------------------------------------------------
# 2. First-Party Faculty Reviews Configuration (Milestone M3 / Feature 17)
# ------------------------------------------------------------------------------
# Master client-side feature flag to enable first-party AmazeCC Faculty Reviews
# MUST default to false for dark-launch safety; toggle to true when ready.
NEXT_PUBLIC_ENABLE_AMAZE_REVIEWS=false

# --- Reviews moderation UI gate ---
# Register numbers / usernames allowed to see the moderation UI in reviews.
# UI gate only — the API's RBAC check is the real authority.
NEXT_PUBLIC_REVIEW_ADMIN_IDS=

# Base endpoint for the Faculty Reviews Cloudflare Worker
# Local Dev: http://localhost:8787
# Staging: https://reviews-api-staging.amazecc.com
# Production: https://reviews-api.amazecc.com
NEXT_PUBLIC_REVIEWS_API_BASE=https://reviews-api.amazecc.com
NEXT_PUBLIC_REVIEWS_API_URL=http://localhost:8787

# Reviews client operation mode:
# - "hybrid": Displays first-party Amaze reviews with vitfac fallback
# - "amaze_only": Displays only verified first-party Amaze reviews
# - "vitfac_only": Redirects entirely to legacy vitfac
NEXT_PUBLIC_AMAZE_REVIEWS_MODE=hybrid

# ------------------------------------------------------------------------------
# 3. Legacy Vitfac Integration & Killswitch
# ------------------------------------------------------------------------------
# Legacy vitfac microservice API endpoint (read-only review catalog worker)
NEXT_PUBLIC_VITFAC_API_URL=https://vitfac.amazecc.com

# Legacy vitfac web platform URL for redirecting student reviews
NEXT_PUBLIC_VITFAC_SITE_URL=https://vitfac.pages.dev

# Killswitch for legacy vitfac review integration (true/false)
# If true, allows fallback to vitfac when first-party reviews are disabled or empty.
NEXT_PUBLIC_ENABLE_VITFAC_INTEGRATION=true

# ------------------------------------------------------------------------------
# 4. Web Push Notifications
# ------------------------------------------------------------------------------
# Web push VAPID public key (generate with `npx web-push generate-vapid-keys`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=REPLACE_ME
