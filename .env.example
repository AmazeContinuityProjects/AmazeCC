MONGODB_URI=

B2_ENDPOINT=
B2_BUCKET_NAME=
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
B2_REGION=

ADMINS=
ID_SALT=

# API URL. Blank falls back to the deployment pinned in src/lib/fetch-utils.ts.
# Defaults to https://hono.amazecc.com (Cloudflare Worker).
NEXT_PUBLIC_API_URL=https://hono.amazecc.com

# Backup API URL -- a full AmazeCC mirror, swapped in globally on failure.
# Defaults to https://api.amazecc.com (traditional Next.js API behind Cloudflare).
NEXT_PUBLIC_BACKUP_API_URL=https://api.amazecc.com

# Ordered mount list for the sync engine, JSON matching src/lib/apis/spec.json.
# Uncomment to replace the bundled defaults entirely (order, baseUrl, name,
# lib, enabled) - unknown lib ids are skipped with a warning.
# NEXT_PUBLIC_API_MOUNTS='{"order":["cache","hono","legacy","unicc"],"mounts":{"hono":{"lib":"hono","baseUrl":"https://hono.amazecc.com","name":"AmazeCC","enabled":true}}}'

# Per-request third-party fallback, used only for the routes UniCC implements,
# after every AmazeCC host has failed. Never becomes the global active URL.
NEXT_PUBLIC_UNICC_API_URL=https://api-unicc.arya22.dev

# Cloudflare Worker serving AmazeCC's public, cacheable data (faculty, buses,
# mess/laundry, changelog, fresher resources). Point at `wrangler dev` (usually
# http://localhost:8787) to test worker changes locally.
NEXT_PUBLIC_WORKER_BASE=https://cache.amazecc.com

# Web Push VAPID Keys (Generate with `npx web-push generate-vapid-keys`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# PostHog client analytics
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_obkUKCrFiFpJGfqSbx9LsJzmZDNdzdHhvpSFDhxSwGUt
NEXT_PUBLIC_POSTHOG_HOST=https://shoot.amazecc.com

# PostHog source map uploads (build time)
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=
